#!/bin/bash

## Description: Copy the Elections working copy into the site's CRM/extensions folder, enable it, upgrade its database and clear the CiviCRM cache
## Usage: deploy-elections
## Example: ddev deploy-elections
## Environment: ELECTIONS_SRC (optional) is the extension folder to deploy; the default is the repository folder next to the site

# One command for WordPress, Drupal and Joomla sites. It reads the project type and docroot that DDEV
# gives every host command:
#   WordPress  docroot httpdocs  -> httpdocs/CRM/extensions   command: cv
#   Drupal 11  docroot web       -> web/CRM/extensions        command: cv
#   Joomla     docroot .         -> CRM/extensions            command: jcv (cv cannot boot Joomla)
# Run it after every change to the extension. Do not run it while a test job is using the site: the
# deploy replaces the files being tested.

set -u

APPROOT="${DDEV_APPROOT:?run this through ddev}"
SRC="${ELECTIONS_SRC:-$APPROOT/../au.com.agileware.elections}"
SRC="${SRC%/}/"

if [ ! -f "${SRC}info.xml" ]; then
  echo "deploy-elections: no extension found at ${SRC} (set ELECTIONS_SRC to the extension folder)" >&2
  exit 1
fi

DOCROOT="${DDEV_DOCROOT-}"
if [ -z "$DOCROOT" ]; then
  DOCROOT="$(sed -n 's/^docroot: *//p' "$APPROOT/.ddev/config.yaml" | tr -d '"' | head -n 1)"
fi
case "$DOCROOT" in
  ''|.) HOST_WEBROOT="$APPROOT"; CONTAINER_WEBROOT="/var/www/html" ;;
  *)    HOST_WEBROOT="$APPROOT/$DOCROOT"; CONTAINER_WEBROOT="/var/www/html/$DOCROOT" ;;
esac

DEST="$HOST_WEBROOT/CRM/extensions/au.com.agileware.elections/"
mkdir -p "$DEST"

# node_modules, .generated, playwright-report and test-results are left alone in the destination so that
# the browser tests keep their installed packages and saved sessions between deploys.
rsync -a --delete \
  --exclude='.git' --exclude='.github' --exclude='.DS_Store' \
  --exclude='node_modules' --exclude='.generated' --exclude='playwright-report' --exclude='test-results' \
  "$SRC" "$DEST" || exit 1

# With Mutagen (the default on macOS) the copy reaches the container a moment later. Wait for it.
ddev mutagen sync >/dev/null 2>&1 || true

case "${DDEV_PROJECT_TYPE:-}" in
  joomla)
    ddev exec "cd '$CONTAINER_WEBROOT' && jcv ext:enable au.com.agileware.elections || true; jcv ext:upgrade-db >/dev/null 2>&1"
    # jcv runs CiviCRM outside Joomla, so any cache it builds has the wrong site address: clear the caches
    # so the first web request builds them with the real one. (Do not truncate civicrm_menu: that gives HTTP 500.)
    ddev exec "mysql -udb -pdb db -e 'TRUNCATE civicrm_cache'; rm -rf '$CONTAINER_WEBROOT'/media/civicrm/templates_c/* '$CONTAINER_WEBROOT'/media/civicrm/ConfigAndLog/Config*"
    ;;
  *)
    ddev exec "cd '$CONTAINER_WEBROOT' && cv flush && cv ext:enable au.com.agileware.elections || true; cv ext:upgrade-db >/dev/null 2>&1; cv flush"
    ;;
esac
