# System libraries and fonts for Chromium, so the Playwright browser tests work after the site is stopped and
# started (they were lost each time). The browser itself is kept outside the container: see config.playwright.yaml.
# The list is what `npx playwright install-deps --dry-run chromium` reports for Debian 13.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends at-spi2-common libasound2-data libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 libatspi2.0-0t64 libdrm-amdgpu1 libdrm-common libdrm2 libgbm1 libgl1 libgl1-mesa-dri libglib2.0-0t64 libglvnd0 libglx-mesa0 libglx0 libllvm19 libnspr4 libnss3 libsensors-config libsensors5 libunwind8 libvulkan1 libwayland-server0 libx11-xcb1 libxcb-dri3-0 libxcb-glx0 libxcb-present0 libxcb-randr0 libxcb-sync1 libxcb-xfixes0 libxcomposite1 libxdamage1 libxfixes3 libxfont2 libxi6 libxkbcommon0 libxkbfile1 libxrandr2 libxshmfence1 libxxf86vm1 libz3-4 mesa-libgallium x11-xkb-utils xfonts-scalable xkb-data xserver-common xvfb \
 && (DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends fonts-freefont-ttf fonts-ipafont-gothic fonts-liberation fonts-noto-color-emoji fonts-tlwg-loma-otf fonts-unifont fonts-wqy-zenhei || true) \
 && rm -rf /var/lib/apt/lists/*
