#!/usr/bin/env php
<?php
/**
 * Lets WordPress answer on http://localhost inside the DDEV container (run inside the web container by create-site.sh).
 *
 *   wp-config-localhost <path to wp-config.php>
 *
 * The Playwright tests run inside the container and use http://localhost. Without this, WordPress redirects every
 * request to its https address, whose certificate the container does not trust. Dev only. Safe to run twice.
 *
 * DDEV writes a minimal wp-config.php that starts with the signature "#ddev-generated" and rewrites it on every
 * start, which would remove the lines added here. Removing the signature line is DDEV's way of saying the file is
 * now yours; the file still includes wp-config-ddev.php, so DDEV keeps providing the database settings.
 */
if ($argc < 2) {
  fwrite(STDERR, "usage: wp-config-localhost <path to wp-config.php>\n");
  exit(2);
}
$file = $argv[1];
$code = is_file($file) ? file_get_contents($file) : FALSE;
if ($code === FALSE) {
  fwrite(STDERR, "wp-config-localhost: cannot read $file\n");
  exit(1);
}
if (strpos($code, 'elections-localhost') !== FALSE) {
  echo "$file: already prepared\n";
  exit(0);
}
$snippet = "// elections-localhost: lets Playwright running inside the DDEV container use http://localhost (dev only).\n"
  . "if ((\$_SERVER['HTTP_HOST'] ?? '') === 'localhost') {\n"
  . "  define('WP_HOME', 'http://localhost');\n"
  . "  define('WP_SITEURL', 'http://localhost');\n"
  . "}\n";
$code = preg_replace_callback('~\A<\?php\r?\n~', fn($m) => $m[0] . $snippet, $code, 1, $count);
if ($count !== 1) {
  fwrite(STDERR, "wp-config-localhost: $file does not start with <?php\n");
  exit(1);
}
// Take the file over from DDEV, so a restart does not overwrite it.
$code = preg_replace('~^[^\n]*#ddev-generated[^\n]*\r?\n~m', '', $code);
file_put_contents($file, $code);
echo "$file: prepared\n";
